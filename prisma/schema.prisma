generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  zh
  en
}

enum ArticleType {
  news
  case
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model Page {
  id        String        @id @default(cuid())
  slug      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  contents  PageContent[]

  @@map("pages")
}

model PageContent {
  id              String   @id @default(cuid())
  pageId          String
  language        Language
  title           String?
  content         String?  // Rich text as JSON string
  bannerImages    String[]
  metaDescription String?
  page            Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([pageId, language])
  @@map("page_contents")
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  titleZh   String?
  titleEn   String?
  bioZh     String?
  bioEn     String?
  photoUrl  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

model Article {
  id           String      @id @default(cuid())
  slug         String
  type         ArticleType
  language     Language
  title        String
  summary      String?
  content      String?     // Rich text as JSON string
  coverImageUrl String?    // Cover image URL for article listing
  author       String?
  publishedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([slug, language])
  @@map("articles")
}

model Banner {
  id             String   @id @default(cuid())
  imageUrl       String
  overlayTextZh  String?
  overlayTextEn  String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("banners")
}

model SiteConfig {
  id        String    @id @default(cuid())
  key       String    @unique
  value     String?
  language  Language?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("site_configs")
}

model PracticeArea {
  id          String   @id @default(cuid())
  imageUrl    String
  titleZh     String
  titleEn     String
  descZh      String?
  descEn      String?
  articleSlug String?  // Link to an article (case type)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("practice_areas")
}

model Client {
  id        String  @id @default(cuid())
  name      String
  logoUrl   String?
  website   String?
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

/// 「加入我们」页面文案，按语言分行。banner/各板块文案都存这里，
/// cards 和 jobs 走关联表。默认值见 src/lib/careersContent.ts。
model CareersContent {
  id        String   @id @default(cuid())
  language  Language @unique
  bannerTitle     String
  bannerSubtitle  String
  bannerQuote     String
  introTitle      String
  introContent    String
  environmentTitle      String
  environmentLabel      String
  environmentContent    String
  environmentImageUrl   String?
  supportTitle    String
  supportLabel    String
  supportLead     String
  creationTitle   String
  creationLabel   String
  creationContent String
  invitationTitle   String
  invitationLabel   String
  invitationContent String
  jobsTitle      String
  contactTitle   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cards    CareersCard[]
  jobs     CareersJob[]

  @@map("careers_contents")
}

/// 板块 2「重磅扶持」的 3 张卡片（10% 点位 / 全包成本 / 轻管理）
model CareersCard {
  id          String          @id @default(cuid())
  careersId   String
  title       String
  content     String
  sortOrder   Int             @default(0)
  careers     CareersContent  @relation(fields: [careersId], references: [id], onDelete: Cascade)

  @@unique([careersId, sortOrder])
  @@map("careers_cards")
}

/// 板块 5「热招岗位」的岗位卡片
model CareersJob {
  id           String          @id @default(cuid())
  careersId    String
  title        String
  tags         String
  requirements String
  duties       String          @default("")
  photoUrl     String?
  sortOrder    Int             @default(0)
  careers      CareersContent  @relation(fields: [careersId], references: [id], onDelete: Cascade)

  @@unique([careersId, sortOrder])
  @@map("careers_jobs")
}

model ContactInfo {
  id        String   @id @default(cuid())
  language  Language @default(zh)
  address   String?
  phone     String?
  email     String?
  wechatQrUrl    String?
  serviceQrUrl   String?
  mapUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([language])
  @@map("contact_info")
}